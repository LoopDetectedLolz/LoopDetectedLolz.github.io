 64, protocol 17 = UDP"],[52,8,"UDP header","port 50010 (Teams' audio source range) to 54056, the SBC's media port"],[60,12,"RTP header","version 2, payload type 0 (PCMU, G.711 mu-law), sequence, timestamp (8 kHz clock, +160 per 20 ms), SSRC 0x4e464e31"],[72,160,"SRTP payload","20 ms of G.711 audio, 160 samples, under AES-128-CTR; without the key it is noise"],[232,10,"SRTP auth tag","HMAC-SHA1-80 over the RTP header, the ciphertext and the rollover counter; a flipped bit fails it"],[242,4,"FCS","CRC-32 over everything before it"]]],"seq0":3100,"ts0":170884160,"ssrc":1313230385,"pt":0,"clock":8000,"step":160,"sport":50010,"dport":54056,"dst":"198.51.100.20","audio":"","loop":50,"keys":{"sdes":"inline:BWnaaqDdz3aY/BXx+v1sMS3o3saV4ycpcqzQOnYe|2^31","master_key":"0569da6aa0ddcf7698fc15f1fafd6c31","master_salt":"2de8dec695e3272972acd03a761e"},"check":{"0":"ed1e154a61d33cc5","1":"631ccd5debbcb601","7":"55a0f709ba018bfa","49":"86009841f5f1cbc6","50":"d0a67674d0d5cc5b","100":"0b0ccf11479ab2f2","1000":"747c27eb2810fff0","14999":"5ed83f33818aa436"},"pcap_bytes":4740024,"note":"15,000 packets, 20 ms apart, five minutes of a call; UDP, so a lost packet is a gap"},"chat":{"name":"Teams chat (TLS over TCP)","pcap":"demo/nfn-teams-chat.pcap","kind":"chat","script":[{"who":"you","t":"10:21:04","text":"Can you hear me? You keep cutting out."},{"who":"tech","t":"10:21:11","text":"Barely. Is that the warehouse AP again?"},{"who":"you","t":"10:21:19","text":"Microwave in the break room. Watch the retries."},{"who":"tech","t":"10:21:27","text":"Moving to the next channel now."},{"who":"you","t":"10:21:38","text":"Better. Crystal clear."},{"who":"tech","t":"10:21:49","text":"Radio is on 149 now, 80 wide. Old channel had utilisation pegged for an hour."},{"who":"you","t":"10:21:58","text":"Retry rate?"},{"who":"tech","t":"10:22:06","text":"38 percent on 2.4. The 5 GHz radio was clean the whole time."},{"who":"you","t":"10:22:15","text":"Then why were the scanners on 2.4?"},{"who":"tech","t":"10:22:26","text":"Band steering is off on that SSID. Somebody turned it off for the label printers."},{"who":"you","t":"10:22:36","text":"Printers are 2.4 only, fine. Scanners do 5. Turn steering back on and exclude the printer OUI."},{"who":"tech","t":"10:22:49","text":"Done. Steering on, printer OUI in the 2.4 only list."},{"who":"you","t":"10:22:57","text":"Note it in the change log so nobody flips it again."},{"who":"tech","t":"10:23:05","text":"Logged."},{"who":"you","t":"10:23:12","text":"Roam a scanner across the dock doors and watch the client page."},{"who":"tech","t":"10:23:22","text":"Walking it now. Hold on."},{"who":"tech","t":"10:23:48","text":"Roamed at -67, landed on 5 GHz, MCS 7 at the far door."},{"who":"you","t":"10:23:56","text":"Good. Still no drops on our call?"},{"who":"tech","t":"10:24:03","text":"None since the channel change."},{"who":"you","t":"10:24:12","text":"Pull the RF health graph for the ticket before it rolls off."},{"who":"tech","t":"10:24:25","text":"Exported. Also the break room is not on the map, it is behind the racks."},{"who":"you","t":"10:24:34","text":"Add it to the survey notes. That microwave is a permanent interferer."},{"who":"tech","t":"10:24:44","text":"Want a channel exclusion on 2.4 for that AP?"},{"who":"you","t":"10:24:53","text":"No. Let the RF management handle it now that steering is on. Watch it tomorrow."},{"who":"tech","t":"10:25:02","text":"Will do. Anything else while I am on the floor?"},{"who":"you","t":"10:25:11","text":"The mezzanine AP showed 3 dB lower Tx power in the audit. Check its port."},{"who":"tech","t":"10:25:31","text":"It is on a 15 W port. PoE budget again."},{"who":"you","t":"10:25:39","text":"Of course it is. Log it, we move it to a 30 W port on the refresh."},{"who":"tech","t":"10:25:48","text":"Logged. Heading back to the closet."},{"who":"you","t":"10:25:55","text":"Send me the screenshots and I will write it up."},{"who":"tech","t":"10:26:02","text":"On the way."},{"who":"you","t":"10:26:09","text":"Great call quality now, by the way."},{"who":"tech","t":"10:26:16","text":"Told you it was the microwave."},{"who":"you","t":"10:26:22","text":"You said warehouse AP."},{"who":"tech","t":"10:26:28","text":"I said it was the warehouse AP's problem."},{"who":"you","t":"10:26:35","text":"Sure you did."}],"sample":["","","",""],"fields":[[[0,2,"Frame Control","0x0801: type Data, To DS = 1 (client to AP)"],[2,2,"Duration","44 microseconds: one SIFS (16) plus the ACK at 24 Mb/s (28), held on every listener's NAV"],[4,6,"Address 1","receiver, the AP's BSSID 02:00:00:00:00:01"],[10,6,"Address 2","transmitter, the client 02:00:00:00:00:02"],[16,6,"Address 3","final destination 02:00:00:00:00:03, the wired side"],[22,2,"Sequence Control","sequence number 400, fragment 0"],[24,8,"LLC / SNAP","AA AA 03, OUI 00 00 00, EtherType 0x0800 = IPv4"],[32,20,"IPv4 header","192.0.2.10 to 203.0.113.40, TTL 64, protocol 6 = TCP"],[52,20,"TCP header","port 51234 to 443, PSH+ACK, the chat session to the Teams service"],[72,5,"TLS record header","0x17 application data, version 3.3, 96 bytes"],[77,8,"TLS nonce","explicit nonce for AES-GCM: record 1 in this direction"],[85,72,"TLS ciphertext","the JSON message under AES-256-GCM with the client write key; 72 bytes of noise without it"],[157,16,"TLS auth tag","GCM tag; a flipped bit fails this before the app ever sees the message"],[173,4,"FCS","CRC-32 over everything before it"]],[[0,2,"Frame Control","0x0802: type Data, From DS = 1 (AP to client)"],[2,2,"Duration","44 microseconds: one SIFS (16) plus the ACK at 24 Mb/s (28), held on every listener's NAV"],[4,6,"Address 1","receiver, the client 02:00:00:00:00:02"],[10,6,"Address 2","transmitter, the AP's BSSID 02:00:00:00:00:01"],[16,6,"Address 3","original source 02:00:00:00:00:03, the wired side"],[22,2,"Sequence Control","sequence number 401, fragment 0"],[24,8,"LLC / SNAP","AA AA 03, OUI 00 00 00, EtherType 0x0800 = IPv4"],[32,20,"IPv4 header","203.0.113.40 to 192.0.2.