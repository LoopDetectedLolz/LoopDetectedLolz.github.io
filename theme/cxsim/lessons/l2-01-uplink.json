{
 "id": "l2-01-uplink",
 "title": "Switching lab: the uplink and the edge",
 "track": "Switching",
 "number": 1,
 "model": "6200F-12",
 "hostname": "access-01",
 "radius": {
  "name": "ClearPass (lab)",
  "servers": [
   "192.0.2.10"
  ],
  "key": "cppm-lab-key"
 },
 "startConfig": [
  "hostname access-01",
  "vlan 10",
  "name STAFF",
  "vlan 20",
  "name PRINTERS",
  "interface 1/1/1-1/1/8",
  "no shutdown",
  "no routing",
  "vlan access 10",
  "interface 1/1/5",
  "vlan access 20",
  "radius-server host 192.0.2.10 key plaintext cppm-lab-key",
  "aaa group server radius CLEARPASS",
  "server 192.0.2.10",
  "vlan 30",
  "name VOICE"
 ],
 "task": "core-01 is cabled to 1/1/13 and 1/1/14 and runs LACP. Build lag 1 across both ports as a trunk carrying VLANs 10, 20 and 30, LACP active. Turn spanning tree on, make 1/1/1 to 1/1/12 edge ports with BPDU guard, then plug everything in. One port should go error-disabled, and it should be the right one.",
 "hints": [
  "interface lag 1 first (no routing, vlan trunk allowed 10,20,30, lacp mode active), then lag 1 inside interface 1/1/13-1/1/14.",
  "spanning-tree in the config context enables it. port-type admin-edge and bpdu-guard are per interface.",
  "show lacp interfaces shows whether the partner agreed. show interface 1/1/8 says why a port is down."
 ],
 "devices": [
  {
   "id": "core-01",
   "name": "Core switch core-01",
   "kind": "switch",
   "port": null,
   "mac": "00:00:5e:00:53:f0",
   "ports": [
    "1/1/13",
    "1/1/14"
   ],
   "lacp": {
    "lag": "any",
    "sysid": "00:00:5e:00:53:f0"
   },
   "stpRoot": true,
   "stpPriority": 4096,
   "bpdu": true,
   "lldp": {
    "sys": "core-01",
    "port": [
     "1/1/21",
     "1/1/22"
    ],
    "chassis": "00:00:5e:00:53:f0",
    "caps": "B,R"
   }
  },
  {
   "id": "desk-switch",
   "name": "Unmanaged desk switch (someone brought it in)",
   "kind": "switch",
   "port": "1/1/8",
   "mac": "00:00:5e:00:53:08",
   "bpdu": true,
   "lldp": {
    "sys": "DGS-1005",
    "port": "1",
    "caps": "B"
   }
  },
  {
   "id": "printer",
   "name": "Printer (HP LaserJet)",
   "kind": "printer",
   "port": "1/1/5",
   "mac": "00:00:5e:00:53:05",
   "auth": {
    "mac-auth": {
     "accept": true,
     "role": "PRINTERS"
    }
   },
   "lldp": {
    "sys": "NPI53A005",
    "port": "eth0",
    "caps": "S"
   }
  },
  {
   "id": "laptop",
   "name": "Laptop (employee.user)",
   "kind": "laptop",
   "port": "1/1/1",
   "mac": "00:00:5e:00:53:01",
   "user": "employee.user",
   "auth": {
    "dot1x": {
     "accept": true,
     "role": "EMPLOYEE"
    },
    "mac-auth": {
     "accept": false,
     "why": "unknown MAC"
    }
   }
  },
  {
   "id": "phone",
   "name": "Desk phone",
   "kind": "phone",
   "port": "1/1/3",
   "mac": "00:00:5e:00:53:03",
   "lldp": {
    "sys": "SEP00005E005303",
    "port": "port1",
    "caps": "B,T"
   },
   "auth": {
    "mac-auth": {
     "accept": true,
     "role": "VOICE"
    }
   }
  }
 ],
 "checks": [
  {
   "desc": "lag 1 is up with both members",
   "lag": {
    "id": 1,
    "members": [
     "1/1/13",
     "1/1/14"
    ]
   }
  },
  {
   "desc": "lag 1 trunks VLANs 10, 20 and 30",
   "config": {
    "context": "interface lag 1",
    "has": "^vlan trunk allowed 10,20,30$"
   }
  },
  {
   "desc": "lag 1 runs LACP active",
   "config": {
    "context": "interface lag 1",
    "has": "^lacp mode active$"
   }
  },
  {
   "desc": "Spanning tree enabled",
   "config": {
    "has": "^spanning-tree$"
   }
  },
  {
   "desc": "1/1/1 is an edge port with BPDU guard",
   "config": {
    "context": "interface 1/1/1",
    "has": "^spanning-tree bpdu-guard$"
   }
  },
  {
   "desc": "The desk switch's port went error-disabled",
   "errdisabled": {
    "port": "1/1/8",
    "is": true
   }
  },
  {
   "desc": "The uplink is forwarding, not blocked",
   "stp": {
    "port": "1/1/13",
    "state": "Forwarding"
   }
  }
 ]
}